NODE_ENV=production
PORT=3333
CORS_ORIGIN=https://projetosespeciais.vercel.app

# Use DATABASE_URL para um PostgreSQL externo. Para o PostgreSQL do Compose,
# as variáveis DB_* são preenchidas automaticamente.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=false

GCS_BUCKET=nome-do-bucket
# Produção/Docker: monte a credencial como arquivo somente leitura.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-service-account.json
# Alternativa para desenvolvimento local:
# GCS_CREDENTIALS_JSON={"type":"service_account"}
